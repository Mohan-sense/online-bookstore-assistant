# START CHATBOT
# --------------------------------------------

print("============================================")
print("      ONLINE BOOKSTORE ASSISTANT")
print("============================================")
print("Type 'bye' to end the conversation.")
print()

conversation = {}

while True:

    user_input = input("You: ")

    if user_input.lower() in ["bye", "goodbye", "exit", "quit"]:

        print("Bot:", chatbot_response(user_input, conversation))
        break

    response = chatbot_response(user_input, conversation)

    print("Bot:", response)
    print()

